{
  "$comment": "Slice 7: single source of truth for the session CONTROL plane (WebSocket JSON). Data plane (binary mesh) stays in schemas/cad_protocol.fbs. protocolVersion = 1 on both planes.",
  "protocolVersion": 1,
  "transport": "WebSocket JSON text frames (both directions). No binary frames on this plane.",
  "envelope": {
    "request": { "requestId": "required non-empty string", "method": "required string", "params": "optional object (default {})" },
    "okReply": { "requestId": "string", "ok": true, "plus": "method-specific payload" },
    "errReply": { "requestId": "string", "ok": false, "errorCode": "required string", "error": "required string" }
  },
  "methods": [
    { "method": "hello", "required": ["token", "protocolVersion"], "optional": ["clientType", "clientName"], "reply": "flat {clientId, sessionId, documentId, revision}; wrong token closes the socket (no reply)" },
    { "method": "snapshot", "required": [], "optional": ["documentId"], "reply": "flat {documentId, revision, features[], sketches[], bodies[], tips[]} (Slice 6 bodies)" },
    { "method": "invoke", "required": ["type"], "optional": ["documentId", "fields", "baseRevision", "transactionId"], "reply": "flat core result + revision" },
    { "method": "txnBegin", "required": ["transactionId"], "optional": ["documentId"], "reply": "flat core result" },
    { "method": "txnCommit", "required": ["transactionId"], "optional": ["documentId"], "reply": "flat core result, one atomic delta" },
    { "method": "txnRollback", "required": ["transactionId"], "optional": ["documentId"], "reply": "flat core result" },
    { "method": "txnForceRollback", "required": ["transactionId"], "optional": ["documentId"], "reply": "flat core result; rejected while the owner is still connected" },
    { "method": "txnStatus", "required": [], "optional": ["documentId"], "reply": "{open, transactionId?, ownerClientId?, ownerConnected?}" },
    { "method": "getDocumentInfo", "required": [], "optional": [], "reply": "{result:{documentId, revision, bodies, features, sketches, tips}}" },
    { "method": "getBodies", "required": [], "optional": [], "reply": "{result:{revision, bodies[{bodyId, tip, history}], tips, sketches}}" },
    { "method": "getFeatures", "required": [], "optional": ["bodyId"], "reply": "{result:{revision, features[], bodies[], tips[]}}" },
    { "method": "getFeature", "required": ["featureId"], "optional": [], "reply": "{result:feature}" },
    { "method": "getParameters", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, paramsMm, expressions}}" },
    { "method": "getDependencies", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, dependsOn[{id, known}]}}" },
    { "method": "getModelTree", "required": [], "optional": [], "reply": "same shape as getBodies" },
    { "method": "describeModel", "required": [], "optional": [], "reply": "{result:{documentId, revision, bodies, features, sketches, types, tips, summary}}" },
    { "method": "getSelection", "required": [], "optional": ["clientId"], "reply": "{result:{clientId, ids}}" },
    { "method": "setSelection", "required": ["ids"], "optional": [], "reply": "{result:{clientId, ids}} + selection broadcast" },
    { "method": "clearSelection", "required": [], "optional": [], "reply": "{result:{clientId, ids:[]}} + selection broadcast" },
    { "method": "findFaces", "required": [], "optional": ["ownerBody", "role", "minTriangles"], "reply": "{result:{faces[]}}" },
    { "method": "findEdges", "required": [], "optional": ["ownerBody", "role"], "reply": "{result:{edges[]}}" },
    { "method": "findBodies", "required": [], "optional": ["type", "minVolumeMm3"], "reply": "{result:{bodies[]}}" },
    { "method": "getManipulators", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, manipulators[]}}" },
    { "method": "measureVolume", "required": [], "optional": ["featureId"], "reply": "{result:{volumeMm3}}" },
    { "method": "measureArea", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, areaMm2}}" },
    { "method": "getBoundingBox", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, bboxMm, volumeMm3}}" },
    { "method": "measureDistance", "required": ["a", "b"], "optional": [], "reply": "{result:{a, b, distanceMm}}" },
    { "method": "measureAngle", "required": ["a", "b"], "optional": [], "reply": "{result:{a, b, angleDeg}}" },
    { "method": "measureRadius", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, radiusMm}}" },
    { "method": "measureDiameter", "required": ["featureId"], "optional": [], "reply": "{result:{featureId, diameterMm}}" },
    { "method": "validateDocument", "required": [], "optional": [], "reply": "{result:{scope:'structural', valid, checks[]}}" },
    { "method": "validateBody", "required": [], "optional": ["bodyId", "featureId"], "reply": "structural checks (needs bodyId or featureId)" },
    { "method": "validateFeature", "required": [], "optional": ["featureId", "bodyId"], "reply": "structural checks (needs featureId or bodyId)" },
    { "method": "listCommands", "required": [], "optional": [], "reply": "{result:{commands[{id, label, description, supportsPreview}]}}" },
    { "method": "getCommandSchema", "required": [], "optional": ["id"], "reply": "always NOT_IMPLEMENTED (per-command schemas arrive with the agent slice)" },
    { "method": "getCapabilities", "required": [], "optional": [], "reply": "{result:{protocolVersion, mutations, queries[], previews, transactions, multiClient, notes}}" },
    { "method": "previewBegin", "required": ["featureId", "paramName"], "optional": ["valueMm", "expression"], "reply": "{result:{previewId, triangles, volumeMm3, bboxMm, revision}}" },
    { "method": "previewUpdate", "required": ["previewId"], "optional": ["valueMm", "expression"], "reply": "{result:{previewId, ...}}" },
    { "method": "previewCommit", "required": ["previewId"], "optional": [], "reply": "flat mutation result" },
    { "method": "previewCancel", "required": ["previewId"], "optional": [], "reply": "{result:{previewId, cancelled:true}}" }
  ],
  "wireErrorCodes": ["MALFORMED", "BAD_HELLO", "NOT_AUTHED", "BAD_PARAMS", "NOT_FOUND", "NOT_IMPLEMENTED", "NEED_FULL_SNAPSHOT", "BUSY", "SESSION_FAILED", "TRANSACTION_BUSY", "NO_TRANSACTION", "NOT_OWNER", "TRANSACTION_TAINTED", "TRANSACTION_OPEN", "CORE_FAILED", "PREVIEW_FAILED", "UNKNOWN_COMMAND"],
  "clientOnlyErrorCodes": ["NOT_CONNECTED", "SEND_FAILED", "CANCELLED", "CLOSED", "RECEIVE_FAILED"],
  "serverEvents": ["delta", "selection", "core-restarted"]
}
