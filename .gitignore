# Kreoda — build outputs, deps and local artifacts are not committed.

# Dependencies
node_modules/

# Build outputs
dist/
.vite/
build/
build-stub/
vcpkg_installed/

# .NET build outputs (protocol C# bindings)
bin/
obj/

# vcpkg toolchain clone (~1.4GB): reinstall with the vcpkg bootstrap and
# point CMAKE_TOOLCHAIN_FILE at it (see native/kreoda-core build docs).
vcpkg/

# Native/editor binaries and intermediates
*.exe
*.dll
*.pdb
*.lib
*.exp
*.obj
*.tlog
*.ilk

# Electron test artifacts (regenerated by `playwright test`)
apps/desktop/test-results/
apps/desktop/e2e/*.png

# Local exchange files produced/consumed by tests and the app
*.icad
*.step
*.stp
*.stl
*.3mf
*.obj
*.gltf
*.glb
*.bin

# IDE / OS
.vs/
*.user
.vscode/
.DS_Store
Thumbs.db
apps/desktop/out/

# Unity imports, generated managed plugins and local player builds
clients/quest-unity/Library/
clients/quest-unity/Temp/
clients/quest-unity/.utmp/
clients/quest-unity/UserSettings/
clients/quest-unity/Logs/
clients/quest-unity/Builds/
clients/quest-unity/Assets/Plugins/Kreoda.Managed/
