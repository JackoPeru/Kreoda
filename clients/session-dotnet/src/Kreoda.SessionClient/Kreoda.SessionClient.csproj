<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless .NET session client (§11, Phase 12 foundation): the same JSON
       session protocol the Quest Unity client will speak, usable from agents,
       tests and tools without an engine. No Unity dependency. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\protocol\csharp\Kreoda.Protocol.csproj" />
  </ItemGroup>

</Project>
