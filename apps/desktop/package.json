{
  "name": "@kreoda/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build:electron": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "start": "electron .vite/build/main.cjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@kreoda/command-schema": "workspace:*",
    "@kreoda/protocol": "workspace:*",
    "@kreoda/units": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toolbar": "^1.1.11",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.545.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.2",
    "xstate": "^5.24.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
